# FandomRates local development configuration
# Never commit real values. GitHub Actions uses the same DB_* names as a
# protected production environment; it does not load this file.
FANDOMRATES_ENV=local
FANDOMRATES_LOAD_DOTENV=1

# Python scraper: required for an explicit --run/--refresh.
DB_HOST=your-project.pooler.supabase.com
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace_me
DB_NAME=postgres
DB_PORT=5432
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=15

# Next.js browser client: anon key only; never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional private correction queue. Configure in Vercel and never expose it
# as NEXT_PUBLIC_*. The endpoint returns a safe unavailable state when absent.
DISCORD_FEEDBACK_WEBHOOK=https://discord.com/api/webhooks/replace_me
